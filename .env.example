# Absolute path to your Obsidian vault on this machine
VAULT_PATH=/home/you/vaults/main

# Required in http mode. Generate with: openssl rand -hex 32
AUTH_TOKEN=

# http (default, for Tailscale/claude.ai) or stdio (for a local Claude Desktop process)
MCP_TRANSPORT=http

# HTTP settings. Keep BIND_HOST on loopback — tailscale serve/funnel proxies to it.
PORT=8484
BIND_HOST=127.0.0.1

# Safety switches
READ_ONLY=false
ALLOW_DELETE=false

# Limits
MAX_READ_BYTES=1000000
MAX_SEARCH_RESULTS=100

# Comma-separated directory names never exposed to Claude
EXCLUDE_DIRS=.obsidian,.trash,.git

# Folder containing YYYY-MM-DD.md daily notes (leave empty for vault root)
DAILY_NOTES_FOLDER=
